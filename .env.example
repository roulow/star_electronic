# Copy to .env.local for local development.
# On Cloudflare these are set in the dashboard instead (see README); values
# entered there are used exactly as typed, so never add quotes there.
#
# In .env files, wrap values containing # or $ in single quotes and write each
# $ as \$, e.g. SMTP_PASS='abc#d\$ef'. Unquoted, # starts a comment and $NAME
# is expanded, which silently changes the value.

# --- Cloudinary: needed by the build (content snapshot) and the Worker ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Build: canonical URLs, hreflang, sitemap.xml and robots.txt ---
NEXT_PUBLIC_SITE_URL=https://www.example.sk

# --- Worker: dashboard login ---
DASHBOARD_KEY=
# Optional separate secret for signing dashboard sessions
# (defaults to one derived from DASHBOARD_KEY).
# SESSION_SECRET=

# --- Worker: contact form email ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# --- Worker (production): rebuilds the site after dashboard changes ---
# Workers Builds deploy hook URL (Settings > Builds > Deploy Hooks).
DEPLOY_HOOK_URL=
