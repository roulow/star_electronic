# Cloudflare static asset headers (copied to out/ by `next build`).

# Hashed build files never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the *.workers.dev address out of search results; only the custom
# domain should be indexed.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
